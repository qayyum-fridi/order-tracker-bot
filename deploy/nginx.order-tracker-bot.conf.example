# Example nginx server block for running this bot alongside an existing "ai-tutor"
# deployment on the same VPS. ai-tutor's app runs as a systemd service proxied at
# 127.0.0.1:5000 — this bot follows the exact same pattern on port 5001 (see
# order-tracker-bot.service.example), so both coexist under nginx with no Docker for
# either app (only SQL Server runs in Docker, shared by both via separate databases).
#
# Install: copy to /etc/nginx/sites-available/order-tracker-bot.conf, symlink into
# sites-enabled, then `certbot --nginx -d order-tracker.yourdomain.com`.

server {
    listen 80;
    server_name order-tracker.yourdomain.com;

    location / {
        proxy_pass http://127.0.0.1:5001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
