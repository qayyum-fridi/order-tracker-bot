# Copy to .env and fill in before running docker compose up -d
# (docker compose reads .env from the same directory automatically)

SQL_SA_PASSWORD=ChangeMe_Strong123!

# Meta WhatsApp Cloud API — https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Any string you choose; enter the same value in the Meta App Dashboard webhook config.
WHATSAPP_VERIFY_TOKEN=
# App secret, used to verify inbound webhook signatures (X-Hub-Signature-256).
WHATSAPP_APP_SECRET=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: n8n (or any) webhook that fans merchant "feedback: ..." messages out to Telegram/email.
FOUNDER_ALERTS_WEBHOOK_URL=
# WhatsApp Flow (form) ids from Meta WhatsApp Manager > Flows; empty = that form falls back to typed entry
WHATSAPP_PRODUCT_FLOW_ID=
WHATSAPP_CUSTOMER_FLOW_ID=
WHATSAPP_ORDER_FLOW_ID=
# true = send unpublished (draft) Flows for testing; remove once the Flows are published
WHATSAPP_FLOW_DRAFT_MODE=false

# Approved WhatsApp marketing template for "broadcast" (body takes one {{1}} = the message); empty = campaigns are recorded, not sent
WHATSAPP_BROADCAST_TEMPLATE=
WHATSAPP_BROADCAST_TEMPLATE_LANG=en
# Seller subscriptions: 14-day trial, then Basic/Pro paid to this JazzCash/Easypaisa number ("paid" reply alerts the founder to verify)
BILLING_ENABLED=true
BILLING_PAYMENT_NUMBER=
